<?xml version="1.0" encoding="utf-8"?>
<!--
  Pictobi のランチャーアイコン前景。
  重なった写真カードの角に小さな小鳥が止まるオリジナルデザイン。
  108x108 のうち中央 66x66 の安全領域に収まるよう 0.9 倍で配置する。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 背面の写真カード (少し傾ける) -->
        <path
            android:fillColor="#143A52"
            android:pathData="M42,27 L80,33 L75,73 L37,67 Z"
            android:strokeColor="#3B7C8C"
            android:strokeWidth="2" />

        <!-- 正面の写真カード -->
        <path
            android:fillColor="#173C55"
            android:pathData="M34,38 L74,38 A6,6 0 0 1 80,44 L80,80 A6,6 0 0 1 74,86 L34,86 A6,6 0 0 1 28,80 L28,44 A6,6 0 0 1 34,38 Z"
            android:strokeColor="#8FEBDD"
            android:strokeWidth="2.5" />

        <!-- 写真の中の風景 (山) -->
        <path
            android:fillColor="#2C6B78"
            android:pathData="M30,80 L42,62 L52,72 L60,64 L78,80 Z" />

        <!-- 写真の中の太陽 (暖色アクセント) -->
        <path
            android:fillColor="#FFB86B"
            android:pathData="M43,50 m-4,0 a4,4 0 1 1 8,0 a4,4 0 1 1 -8,0" />

        <!-- 小鳥の尾羽 -->
        <path
            android:fillColor="#5FE0CB"
            android:pathData="M57,39 L45,24 L48,36 L41,34 L50,46 Z" />

        <!-- 小鳥の体 -->
        <path
            android:fillColor="#7FE7D4"
            android:pathData="M62,33 C70,33 76,39 76,47 C76,56 70,62 62,62 C55,62 50,57 50,51 C50,42 55,33 62,33 Z" />

        <!-- おなか -->
        <path
            android:fillColor="#D8FFF7"
            android:pathData="M63,44 C68,44 72,48 72,53 C72,58 68,61 63,61 C58,61 55,58 55,54 C55,49 58,44 63,44 Z" />

        <!-- 翼 -->
        <path
            android:fillColor="#3CC7B3"
            android:pathData="M57,45 C62,41 69,42 73,47 C70,51 66,54 60,54 C56,54 54,50 57,45 Z" />

        <!-- 頭 -->
        <path
            android:fillColor="#7FE7D4"
            android:pathData="M71,31 m-7,0 a7,7 0 1 1 14,0 a7,7 0 1 1 -14,0" />

        <!-- くちばし -->
        <path
            android:fillColor="#FFB86B"
            android:pathData="M77,35 L86,38 L77,41 Z" />

        <!-- 目 -->
        <path
            android:fillColor="#0B1524"
            android:pathData="M73,34 m-1.8,0 a1.8,1.8 0 1 1 3.6,0 a1.8,1.8 0 1 1 -3.6,0" />

        <!-- 足 -->
        <path
            android:pathData="M62,61 L61,68"
            android:strokeColor="#FFB86B"
            android:strokeLineCap="round"
            android:strokeWidth="1.8" />
        <path
            android:pathData="M68,61 L69,68"
            android:strokeColor="#FFB86B"
            android:strokeLineCap="round"
            android:strokeWidth="1.8" />
    </group>
</vector>
